<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PolyPilotMauiDemoTest.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:PolyPilotMauiDemoTest.Localization"
    xmlns:local="clr-namespace:PolyPilotMauiDemoTest"
    Title="PolyPilotMauiDemoTest">

    <ShellContent
        Title="{l:Translate Dashboard_Title}"
        ContentTemplate="{DataTemplate local:DashboardPage}"
        Route="dashboard" />

    <ShellContent
        Title="{l:Translate Settings_Title}"
        ContentTemplate="{DataTemplate local:SettingsPage}"
        Route="settings" />

</Shell>
